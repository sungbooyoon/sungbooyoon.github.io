---
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import SiteNavigation from '../components/astryx/SiteNavigation';
import SiteShell from '../components/astryx/SiteShell';
import siteConfig from '../data/site-config';

export type Props = HeadProps & { showHeader?: boolean };

const { showHeader = true, ...head } = Astro.props;
const avatarSrc = siteConfig.avatar?.src;
const resolvedAvatarSrc = typeof avatarSrc === 'string' ? avatarSrc : avatarSrc?.src;
---

<!doctype html>
<html lang="en" data-astryx-theme="site">
    <head>
        <BaseHead {...head} />
        <script is:inline>
            const savedMode = localStorage.getItem('astryx-theme');
            if (savedMode === 'light' || savedMode === 'dark') {
                document.documentElement.dataset.theme = savedMode;
            }
        </script>
    </head>
    <body>
        <SiteShell
            title={siteConfig.title}
            subtitle={siteConfig.subtitle}
            avatarSrc={resolvedAvatarSrc}
            showHeader={showHeader}
            footerNavLinks={siteConfig.footerNavLinks ?? []}
            socialLinks={siteConfig.socialLinks ?? []}
        >
            <SiteNavigation slot="navigation" client:load pathname={Astro.url.pathname} title={siteConfig.title} links={siteConfig.headerNavLinks ?? []} />
            <slot />
        </SiteShell>
    </body>
</html>
