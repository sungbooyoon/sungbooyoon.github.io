---
import { type CollectionEntry, getCollection } from 'astro:content';
import { ArticleSurface, MarkdownBody, PageHeader } from '../components/astryx/PageSurface';
import OutlinedMarkdown from '../components/astryx/OutlinedMarkdown';
import BaseLayout from '../layouts/BaseLayout.astro';
import { prepareAstryxMarkdown } from '../utils/markdown-utils';

export async function getStaticPaths() {
    const pages = await getCollection('pages');
    return pages.map((page) => {
        return {
            params: { id: page.id },
            props: { page }
        };
    });
}

type Props = { page: CollectionEntry<'pages'> };

const { page } = Astro.props;
const { title, seo } = page.data;
const content = await prepareAstryxMarkdown(page.body);
const hasOutline = page.id === 'about' || page.id === 'publications';
---

<BaseLayout title={seo?.title ?? title} description={seo?.description} image={seo?.image} showHeader={false}>
    <ArticleSurface>
        <PageHeader title={title} />
        {hasOutline ? <OutlinedMarkdown client:load content={content} sectioned={page.id === 'about'} /> : <MarkdownBody content={content} />}
    </ArticleSurface>
</BaseLayout>
