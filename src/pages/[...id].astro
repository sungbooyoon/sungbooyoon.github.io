---
import { type CollectionEntry, getCollection } from 'astro:content';
import daewooIcon from '../assets/icons/daewoo.svg?url';
import policeIcon from '../assets/icons/police.svg?url';
import snuIcon from '../assets/icons/snu.svg?url';
import { ArticleSurface, MarkdownBody, PageHeader } from '../components/astryx/PageSurface';
import OutlinedMarkdown from '../components/astryx/OutlinedMarkdown';
import PublicationLibrary from '../components/astryx/PublicationLibrary';
import BaseLayout from '../layouts/BaseLayout.astro';
import { prepareAstryxMarkdown } from '../utils/markdown-utils';
import { parsePublicationsMarkdown } from '../utils/publication-utils';

export async function getStaticPaths() {
    const pages = await getCollection('pages');
    return pages.map((page) => {
        return {
            params: { id: page.id },
            props: { page }
        };
    });
}

type Props = { page: CollectionEntry<'pages'> };

const { page } = Astro.props;
const { title, seo } = page.data;
const content = await prepareAstryxMarkdown(page.body);
const hasOutline = page.id === 'about';
const publicationPage = page.id === 'publications' ? parsePublicationsMarkdown(content) : null;
const organizationIcons = hasOutline
    ? {
          snu: { src: snuIcon, label: 'Seoul National University' },
          daewoo: { src: daewooIcon, label: 'Daewoo E&C' },
          police: { src: policeIcon, label: 'Korean National Police Agency' }
      }
    : undefined;
---

<BaseLayout title={seo?.title ?? title} description={seo?.description} image={seo?.image} showHeader={false}>
    <ArticleSurface>
        <PageHeader title={title} />
        {
            publicationPage ? (
                <PublicationLibrary client:load intro={publicationPage.intro} entries={publicationPage.entries} />
            ) : hasOutline ? (
                <OutlinedMarkdown client:load content={content} sectioned outlineDepth={2} enableLightbox organizationIcons={organizationIcons} />
            ) : (
                <MarkdownBody content={content} />
            )
        }
    </ArticleSurface>
</BaseLayout>
