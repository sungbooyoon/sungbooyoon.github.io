---
import type { GetStaticPathsOptions, Page } from 'astro';
import { type CollectionEntry, getCollection } from 'astro:content';
import Pagination from '../../components/Pagination.astro';
import ContentList from '../../components/astryx/ContentList';
import { PageStack } from '../../components/astryx/PageSurface';
import siteConfig from '../../data/site-config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../../utils/data-utils';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const projects = (await getCollection('projects')).sort(sortItemsByDateDesc);
    return paginate(projects, { pageSize: siteConfig.projectsPerPage || 6 });
}

type Props = { page: Page<CollectionEntry<'projects'>> };

const { page } = Astro.props;
const portfolio = page.data;
const entries = portfolio.map((project) => ({
    title: project.data.title,
    description: project.data.description,
    href: project.data.externalUrl ?? `/projects/${project.id}/`,
    isExternal: Boolean(project.data.externalUrl)
}));
---

<BaseLayout title="Projects" description="Explore a diverse portfolio showcasing my passion and expertise" showHeader={false}>
    <PageStack>
        <ContentList entries={entries} heading="Projects" headingLevel={1} itemHeadingLevel={2} />
        <Pagination page={page} />
    </PageStack>
</BaseLayout>
