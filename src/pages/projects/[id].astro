---
import { type CollectionEntry, getCollection } from 'astro:content';
import { Text } from '@astryxdesign/core/Text';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentList from '../../components/astryx/ContentList';
import CopyButton from '../../components/astryx/CopyButton';
import OutlinedMarkdown from '../../components/astryx/OutlinedMarkdown';
import { ArticleActions, ArticleSurface, PageHeader, PageStack } from '../../components/astryx/PageSurface';
import ProjectMetadata from '../../components/astryx/ProjectMetadata';
import { sortItemsByDateDesc } from '../../utils/data-utils';
import { prepareAstryxMarkdown } from '../../utils/markdown-utils';

export async function getStaticPaths() {
    const projects = (await getCollection('projects')).sort(sortItemsByDateDesc);
    const projectCount = projects.length;
    return projects.map((project, index) => ({
        params: { id: project.id },
        props: {
            project,
            prevProject: index + 1 !== projectCount ? projects[index + 1] : null,
            nextProject: index !== 0 ? projects[index - 1] : null
        }
    }));
}

type Props = {
    project: CollectionEntry<'projects'>;
    prevProject: CollectionEntry<'projects'>;
    nextProject: CollectionEntry<'projects'>;
};

const { href } = Astro.url;
const { project, prevProject, nextProject } = Astro.props;
const { title, description, status, period, role, tags = [], sources = [], updatedDate, seo } = project.data;
const lastUpdated = updatedDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const preparedContent = await prepareAstryxMarkdown(project.body);
const citationSources = Object.fromEntries(sources.map((source, index) => [`source-${index + 1}`, source]));
const sourceList = sources.length > 0 ? `\n\n## Sources\n\n${sources.map((_, index) => `[source-${index + 1}]`).join(' ')}` : '';
const content = `${preparedContent}${sourceList}`;
const nextEntries = [nextProject, prevProject]
    .filter((entry): entry is CollectionEntry<'projects'> => Boolean(entry))
    .map((entry) => ({
        title: entry.data.title,
        description: entry.data.description,
        href: entry.data.externalUrl ?? `/projects/${entry.id}/`,
        isExternal: Boolean(entry.data.externalUrl)
    }));
---

<BaseLayout title={seo?.title ?? title} description={seo?.description ?? description} image={seo?.image} pageType="article" showHeader={false}>
    <PageStack>
        <ArticleSurface>
            <PageHeader title={title} />
            <ProjectMetadata status={status} tags={tags} period={period} role={role} />
            <Text as="p" type="supporting" color="secondary">Last updated {lastUpdated}</Text>
            <OutlinedMarkdown client:load content={content} sources={citationSources} enableLightbox />
            <ArticleActions align="end">
                <CopyButton client:load value={href} />
            </ArticleActions>
        </ArticleSurface>
        {(prevProject || nextProject) && <ContentList entries={nextEntries} heading="View next" />}
    </PageStack>
</BaseLayout>
