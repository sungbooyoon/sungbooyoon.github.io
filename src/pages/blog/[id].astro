---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Subscribe from '../../components/Subscribe.astro';
import ContentList from '../../components/astryx/ContentList';
import CopyButton from '../../components/astryx/CopyButton';
import OutlinedMarkdown from '../../components/astryx/OutlinedMarkdown';
import { ArticleActions, ArticleSurface, PageHeader, PageStack } from '../../components/astryx/PageSurface';
import TagLinks from '../../components/astryx/TagLinks';
import { sortItemsByDateDesc } from '../../utils/data-utils';
import { formatDate } from '../../utils/common-utils';
import { prepareAstryxMarkdown } from '../../utils/markdown-utils';

export async function getStaticPaths() {
    const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
    const postCount = posts.length;
    return posts.map((post, index) => ({
        params: { id: post.id },
        props: {
            post,
            prevPost: index + 1 !== postCount ? posts[index + 1] : null,
            nextPost: index !== 0 ? posts[index - 1] : null
        }
    }));
}

type Props = { post: CollectionEntry<'blog'>; prevPost: CollectionEntry<'blog'>; nextPost: CollectionEntry<'blog'> };

const { href } = Astro.url;
const { post, prevPost, nextPost } = Astro.props as Props;
const { title, publishDate, updatedDate, excerpt, tags = [], seo } = post.data;
const content = await prepareAstryxMarkdown(post.body);
const nextEntries = [nextPost, prevPost]
    .filter((entry): entry is CollectionEntry<'blog'> => Boolean(entry))
    .map((entry) => ({
        title: entry.data.title,
        description: entry.data.excerpt,
        meta: formatDate(entry.data.publishDate),
        href: `/blog/${entry.id}/`
    }));
---

<BaseLayout title={seo?.title ?? title} description={seo?.description ?? excerpt} image={seo?.image} pageType="article" showHeader={false}>
    <PageStack>
        <ArticleSurface>
            <PageHeader title={title} description={excerpt} meta={`${formatDate(publishDate)}${updatedDate ? ` · Updated ${formatDate(updatedDate)}` : ''}`} />
            <OutlinedMarkdown client:load content={content} />
            <ArticleActions>
                {tags.length > 0 && <TagLinks tags={tags} />}
                <CopyButton client:load value={href} />
            </ArticleActions>
        </ArticleSurface>
        {(prevPost || nextPost) && <ContentList entries={nextEntries} heading="Read next" />}
        <Subscribe />
    </PageStack>
</BaseLayout>
