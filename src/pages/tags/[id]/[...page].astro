---
import type { GetStaticPathsOptions, Page } from 'astro';
import { getCollection } from 'astro:content';
import Pagination from '../../../components/Pagination.astro';
import ContentList from '../../../components/astryx/ContentList';
import { PageStack } from '../../../components/astryx/PageSurface';
import siteConfig from '../../../data/site-config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllTags, getItemsByTag, sortItemsByDateDesc, type TaggableEntry } from '../../../utils/data-utils';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const projects = await getCollection('projects');
    const items = projects.sort(sortItemsByDateDesc);
    const tags = getAllTags(items);

    return tags.flatMap((tag) => {
        const filteredItems = getItemsByTag(items, tag.id);
        return paginate(filteredItems, {
            params: { id: tag.id },
            pageSize: siteConfig.postsPerPage || 4
        });
    });
}

type Props = { page: Page<TaggableEntry> };

const { page } = Astro.props;
const taggedItems = page.data;
const params = Astro.params;
const allProjects = await getCollection('projects');
const allTags = getAllTags(allProjects);
const currentTag = allTags.find((tag) => {
    return tag.id === params.id;
});

const entries = taggedItems.map((item) => ({
    title: item.data.title,
    description: item.data.description,
    href: item.data.externalUrl ?? `/projects/${item.id}/`,
    isExternal: Boolean(item.data.externalUrl)
}));
---

<BaseLayout title={`Tagged ${currentTag?.name}`} description={`Explore projects tagged ${currentTag?.name}`} showHeader={false}>
    <PageStack>
        <ContentList entries={entries} heading={`Tagged “${currentTag?.name}”`} headingLevel={1} itemHeadingLevel={2} />
        <Pagination page={page} />
    </PageStack>
</BaseLayout>
