---
import { getCollection } from 'astro:content';
import Hero from '../components/Hero.astro';
import ProjectCarousel from '../components/astryx/ProjectCarousel';
import PublicationCarousel from '../components/astryx/PublicationCarousel';
import { PageStack } from '../components/astryx/PageSurface';
import selectedPublications from '../data/selected-publications';
import siteConfig from '../data/site-config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../utils/data-utils';

const projects = (await getCollection('projects')).sort(sortItemsByDateDesc);
const featuredProjects = projects.filter(({ data }) => data.isFeatured);
const featuredProjectEntries = featuredProjects.map((project) => ({
    title: project.data.title,
    description: project.data.description,
    href: project.data.externalUrl ?? `/projects/${project.id}/`,
    isExternal: Boolean(project.data.externalUrl),
    tags: project.data.tags
}));
---

<BaseLayout description={siteConfig.description}>
    <PageStack>
        <Hero {...siteConfig.hero} />
        {featuredProjects.length > 0 && <ProjectCarousel client:load entries={featuredProjectEntries} />}
        <PublicationCarousel client:load entries={selectedPublications} />
    </PageStack>
</BaseLayout>
