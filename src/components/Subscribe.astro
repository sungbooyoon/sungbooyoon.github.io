---
import siteConfig from '../data/site-config';
import SubscribeForm from './astryx/SubscribeForm';

const subscribe = siteConfig.subscribe;
if (!subscribe?.enabled || !subscribe?.form?.action) {
    return;
}
---

<SubscribeForm
    client:load
    action={subscribe.form.action}
    title={subscribe.title}
    description={subscribe.text}
    emailFieldName={subscribe.form.emailFieldName}
    hiddenFields={subscribe.form.hiddenFields}
    honeypotFieldName={subscribe.form.honeypotFieldName}
/>
