---
import { getImage } from 'astro:assets';
import type { Hero as HeroProps } from '../types';
import HeroContent from './astryx/HeroContent';

type Props = HeroProps;

const { title, image, images, text, actions = [] } = Astro.props;
const heroImages = images?.length ? images : image?.src ? [image] : [];
const resolvedImages = await Promise.all(
    heroImages.map(async (heroImage) => {
        if (typeof heroImage.src === 'string') {
            return { src: heroImage.src, alt: heroImage.alt ?? '', caption: heroImage.caption };
        }

        const optimized = await getImage({
            src: heroImage.src,
            width: 1200,
            height: 675,
            format: 'webp',
            fit: 'cover'
        });

        return { src: optimized.src, alt: heroImage.alt ?? '', caption: heroImage.caption };
    })
);
---

<HeroContent client:load title={title} text={text} images={resolvedImages} actions={actions} />
